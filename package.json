{
  "name": "filenest",
  "version": "0.1.0",
  "description": "A modern, TypeScript-native multipart/form-data middleware for Express and Node.js — a maintained, secure successor to multer.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "multipart",
    "form-data",
    "upload",
    "file-upload",
    "express",
    "middleware",
    "multer"
  ],
  "license": "MIT",
  "author": "azaresw (https://github.com/azaresw)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azaresw/filenest.git"
  },
  "homepage": "https://github.com/azaresw/filenest#readme",
  "bugs": {
    "url": "https://github.com/azaresw/filenest/issues"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.6.2",
    "eslint": "^9.9.0",
    "tsup": "^8.2.4",
    "typescript": "^5.6.2",
    "vitest": "^5.0.1"
  }
}
